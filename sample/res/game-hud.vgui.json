{
  "format": "vgui-ui-design",
  "version": 1,
  "root": "hud",
  "nodes": {
    "hud": {
      "type": "panel",
      "name": "Arena HUD",
      "props": {"layout": "absolute", "nav_start": "skill1"},
      "children": ["vitals", "status_plate", "minimap", "hotbar", "ult", "crosshair", "pause_button", "pause_dialog"]
    },
    "vitals": {
      "type": "panel",
      "name": "Vitals",
      "props": {"anchor_safe_area": true, "x": 16, "y": 16, "width": 266, "height": 66, "layout": "column", "gap": 6,
        "pad_left": 8, "pad_top": 8, "pad_right": 8, "pad_bottom": 8, "background": "#18141098", "input_enabled": false},
      "children": ["hp_row", "shield_row"]
    },
    "hp_row": {"type": "panel", "props": {"layout": "row", "gap": 8, "align_items": "center", "background": "#00000000"}, "children": ["hp_label", "hp"]},
    "hp_label": {"type": "label", "props": {"text": "HP", "width": 48}},
    "hp": {"type": "progress", "props": {"grow": 1, "height": 16, "value": 1, "bind_value": "player.hp_ratio", "accent_color": "#E66C6C"}},
    "shield_row": {"type": "panel", "props": {"layout": "row", "gap": 8, "align_items": "center", "background": "#00000000"}, "children": ["shield_label", "shield"]},
    "shield_label": {"type": "label", "props": {"text": "SHLD", "width": 48}},
    "shield": {"type": "progress", "props": {"grow": 1, "height": 16, "value": 0.5, "bind_value": "player.shield_ratio"}},
    "status_plate": {
      "type": "panel",
      "name": "Runtime status",
      "props": {"anchor_x": "end", "anchor_safe_area": true, "x": -16, "y": 16, "width": 520, "height": 38, "layout": "column", "align_items": "stretch",
        "pad_left": 10, "pad_top": 8, "pad_right": 10, "pad_bottom": 8, "background": "#18141098", "input_enabled": false},
      "children": ["status"]
    },
    "status": {"type": "label", "props": {"text": "M: compositing mode", "font_size": 14}},
    "minimap": {"type": "panel", "name": "Minimap (host draws)", "props": {
      "anchor_y": "end", "anchor_safe_area": true, "x": 16, "y": -16, "width": 180, "height": 180,
      "layout": "column", "align_items": "stretch", "background": "#00000000", "input_enabled": false}},
    "hotbar": {
      "type": "panel",
      "name": "Skills",
      "props": {"anchor_x": "center", "anchor_y": "end", "anchor_safe_area": true, "y": -16,
        "width": 488, "height": 80, "layout": "row", "gap": 8,
        "pad_left": 8, "pad_top": 8, "pad_right": 8, "pad_bottom": 8, "background": "#18141080"},
      "children": ["slot1", "slot2", "slot3", "slot4", "slot5", "slot6"]
    },
    "slot1": {"type": "panel", "props": {"layout": "column", "gap": 4, "background": "#00000000"}, "children": ["skill1", "cooldown1"]},
    "skill1": {"type": "button", "props": {"text": "Q", "width": 56, "height": 36, "action": "hud.skill.1", "focus_alpha": 1, "nav_left": "skill6", "nav_up": "pause_button"}},
    "cooldown1": {"type": "progress", "props": {"width": 56, "height": 16, "bind_value": "skill.1.cooldown"}},
    "slot2": {"type": "panel", "props": {"layout": "column", "gap": 4, "background": "#00000000"}, "children": ["skill2", "cooldown2"]},
    "skill2": {"type": "button", "props": {"text": "W", "width": 56, "height": 36, "action": "hud.skill.2", "focus_alpha": 1}},
    "cooldown2": {"type": "progress", "props": {"width": 56, "height": 16, "bind_value": "skill.2.cooldown"}},
    "slot3": {"type": "panel", "props": {"layout": "column", "gap": 4, "background": "#00000000"}, "children": ["skill3", "cooldown3"]},
    "skill3": {"type": "button", "props": {"text": "E", "width": 56, "height": 36, "action": "hud.skill.3", "focus_alpha": 1}},
    "cooldown3": {"type": "progress", "props": {"width": 56, "height": 16, "bind_value": "skill.3.cooldown"}},
    "slot4": {"type": "panel", "props": {"layout": "column", "gap": 4, "background": "#00000000"}, "children": ["skill4", "cooldown4"]},
    "skill4": {"type": "button", "props": {"text": "R", "width": 56, "height": 36, "action": "hud.skill.4", "focus_alpha": 1}},
    "cooldown4": {"type": "progress", "props": {"width": 56, "height": 16, "bind_value": "skill.4.cooldown"}},
    "slot5": {"type": "panel", "props": {"layout": "column", "gap": 4, "background": "#00000000"}, "children": ["skill5", "cooldown5"]},
    "skill5": {"type": "button", "props": {"text": "T", "width": 56, "height": 36, "action": "hud.skill.5", "focus_alpha": 1}},
    "cooldown5": {"type": "progress", "props": {"width": 56, "height": 16, "bind_value": "skill.5.cooldown"}},
    "slot6": {"type": "panel", "props": {"layout": "column", "gap": 4, "background": "#00000000"}, "children": ["skill6", "cooldown6"]},
    "skill6": {"type": "button", "props": {"text": "Y", "width": 56, "height": 36, "action": "hud.skill.6", "focus_alpha": 1, "nav_right": "skill1"}},
    "cooldown6": {"type": "progress", "props": {"width": 56, "height": 16, "bind_value": "skill.6.cooldown"}},
    "ult": {"type": "progress", "name": "Ultimate", "props": {
      "anchor_x": "center", "anchor_y": "end", "anchor_safe_area": true, "x": 274, "y": -52, "width": 44, "height": 44,
      "radial": true, "bind_value": "player.ult_cooldown", "accent_color": "#FFA040", "track_color": "#40282050", "input_enabled": false}},
    "crosshair": {"type": "panel", "name": "Crosshair (host draws)", "props": {
      "anchor_x": "center", "anchor_y": "center", "anchor_safe_area": false,
      "width": 32, "height": 32, "layout": "column", "align_items": "stretch", "background": "#00000000", "input_enabled": false}},
    "pause_button": {"type": "button", "props": {
      "anchor_safe_area": true, "x": 16, "y": 94, "width": 112, "height": 32, "text": "Pause menu",
      "open_modal": "pause_dialog", "nav_down": "skill1", "focus_alpha": 1}},
    "pause_dialog": {"type": "panel", "name": "Pause menu", "props": {
      "modal": true, "modal_start_focus": "pause_close", "modal_return_focus": "skill1", "anchor_x": "center", "anchor_y": "center",
      "width": 360, "height": 176, "layout": "column", "align_items": "stretch",
      "pad_left": 20, "pad_top": 17, "pad_right": 20, "pad_bottom": 17, "gap": 10,
      "background": "#263144", "border_color": "#638AB0", "border_width": 1},
      "children": ["pause_title", "pause_hint", "pause_close"]},
    "pause_title": {"type": "label", "props": {"text": "Pause menu", "font_size": 22}},
    "pause_hint": {"type": "label", "props": {"text": "Esc / B to go back", "font_size": 15}},
    "pause_close": {"type": "button", "props": {"text": "Back to skills", "height": 38, "close_modal": true, "focus_alpha": 1}}
  },
  "resources": {}
}
